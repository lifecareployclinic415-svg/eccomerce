# =====================================================================
# .env.local
#
# Save this at your project root. It MUST be git-ignored.
# Verify with:  git check-ignore .env.local
# (it should print the filename; if it prints nothing, STOP and fix
#  .gitignore before you commit anything)
#
# Rule that runs through this whole file:
#   NEXT_PUBLIC_*  → shipped to the browser. Assume the world can read it.
#   everything else → server only. Never add the NEXT_PUBLIC_ prefix to
#                     any of them, no matter how convenient it seems.
# =====================================================================


# ---------------------------------------------------------------------
# SUPABASE — required now (Phase 3)
# Dashboard → Project Settings → API Keys
# ---------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=

# Public by design. RLS is what protects your data, not this key's secrecy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ⚠️ PASTE YOUR **NEW** SECRET KEY HERE — not the one from our chat.
# That one is compromised and must be revoked.
# This key BYPASSES every RLS policy. It is the one credential where a
# leak means full read/write on every customer record you will ever hold.
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------------------
# APP — required now
# ---------------------------------------------------------------------

# Used for auth redirects, canonical URLs, sitemaps and OG images.
# Change to your real domain in Vercel's production environment.
NEXT_PUBLIC_SITE_URL=


# =====================================================================
# EVERYTHING BELOW IS OPTIONAL UNTIL YOU REACH THAT FEATURE.
# Leave blank and the code skips it — nothing crashes on an empty value.
# =====================================================================


# ---------------------------------------------------------------------
# PAYMENTS (Phase 10)
# ---------------------------------------------------------------------

# Razorpay — domestic UPI, netbanking, RuPay. dashboard.razorpay.com
# Start in TEST mode. The key id reaches the browser via a server action,
# which is why it is not NEXT_PUBLIC_ — rotating it needs no redeploy.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks. Set the endpoint to /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Stripe — international cards. dashboard.stripe.com
STRIPE_SECRET_KEY=
# ⚠️ Stripe signs TEST and LIVE events with DIFFERENT secrets. Mixing
# them is the single most common cause of "webhook verification failed"
# in production while everything works locally.
STRIPE_WEBHOOK_SECRET=


# ---------------------------------------------------------------------
# EMAIL (Phase 9)
#
# NOTE: these two are NOT read from this file. They are Edge Function
# secrets. Set them with:
#   npx supabase secrets set RESEND_API_KEY=re_xxx ORDER_FROM="Store <orders@yourdomain.com>"
#
# Listed here only so you have one place that records every credential.
# ---------------------------------------------------------------------

# RESEND_API_KEY=
# ORDER_FROM=

# Separately: configure custom SMTP in Supabase → Authentication.
# The built-in sender caps at ~2 emails/hour and will silently drop
# password resets in production.


# ---------------------------------------------------------------------
# STORAGE (Phase 11)
# ---------------------------------------------------------------------

# "true" routes images through Supabase's transform CDN (PRO PLAN ONLY,
# billed per distinct origin image). Leave unset on the free plan and
# Next.js handles optimisation instead. No component code changes either
# way — it is switched at the loader.
NEXT_PUBLIC_USE_SUPABASE_TRANSFORMS=


# ---------------------------------------------------------------------
# ANALYTICS (Phase 14)
#
# All of these are consent-gated. Setting them does NOT start tracking —
# nothing fires until the visitor opts in.
# ---------------------------------------------------------------------

# Use GTM *or* a direct GA4 tag, never both — that double-counts every
# event, including revenue.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Server-side conversion tracking. These fire from the payment webhook,
# so they survive ad blockers and closed tabs.
GA_API_SECRET=
META_CAPI_TOKEN=


# ---------------------------------------------------------------------
# TESTING (Phase 16)
# ---------------------------------------------------------------------

PLAYWRIGHT_BASE_URL=


# =====================================================================
# ALSO CREATE .env.example
#
# Copy this file, blank every value (keep the comments), and COMMIT that
# one. It documents which variables exist without leaking any of them —
# which is what makes onboarding a second developer painless.
# =====================================================================

